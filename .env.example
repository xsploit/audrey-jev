# Never commit real keys. Use a Discord APPLICATION BOT token, not a user token.
DISCORD_TOKEN=
# Optional: restrict server use to one guild; leave blank for mentions in joined guilds.
DISCORD_GUILD_ID=
# Optional: your Discord user ID for admin controls from DMs.
DISCORD_OWNER_ID=
# PASSIVE listening only. Mentions/replies and DMs work without this list.
# Explicit text-channel IDs, comma-separated; threads are not implicitly included.
DISCORD_CHANNEL_IDS=
# Whole-server passive listening, including new accessible channels/threads. Notify participants.
PASSIVE_GUILD_IDS=
# Only IDs of users who have requested default memory proposals; OFF/forget still overrides this.
MEMORY_DEFAULT_USER_IDS=
AI_GATEWAY_API_KEY=

BOT_NAME=Audrey
BOT_INTERESTS=coding, AI, Linux, synthesizers, music production
# true: evaluate and update demo mood, but never send automatic channel replies.
DRY_RUN=false
# Experiment default: Jev can join conversations and initiate in configured listening scopes.
ALLOW_PROACTIVE=true
# Optional text-generation model on Vercel Gateway. Empty = visibly labeled diagnostic reply.
WRITER_MODEL=google/gemini-3-flash
ENABLE_MOOD=true
ENABLE_MEMORY=true
ENABLE_REACTIONS=true
# DMs use a shorter 2-second cooldown.
CHANNEL_COOLDOWN_SECONDS=30
MAX_EVALUATIONS_PER_HOUR=120
MAX_CALLS_PER_MINUTE=10
DATA_FILE=./data/state.json
# Escape scene panels use Components V2; false uses traditional embeds + controls.
ESCAPE_COMPONENTS_V2=true
# Install the CLI once: uv tool install edge-tts. No Azure API key needed; uses Microsoft's online service.
ESCAPE_TTS_ENABLED=true
# edge or fish. Fish uses exactly s2.1-pro-free and requires FISH_API_KEY.
ESCAPE_TTS_PROVIDER=edge
EDGE_TTS_VOICE=en-US-AriaNeural
EDGE_TTS_PITCH=+26Hz
EDGE_TTS_RATE=+3%
EDGE_TTS_VOLUME=+0%
# Optional absolute path if edge-tts is not in the bot process's PATH.
EDGE_TTS_COMMAND=edge-tts
# Hosted Fish for the escape game or Voice Lab; exact model: s2.1-pro-free.
FISH_API_KEY=
FISH_REFERENCE_ID=ee4867b6908d41e58ee7736ce4874622
